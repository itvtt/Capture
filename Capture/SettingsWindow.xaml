<Window x:Class="Capture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="설정 - Capture"
        Icon="Assets/Capture.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" Deactivated="Window_Deactivated" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 단축키 칸: 누르면 파란 테두리로 키를 기다림 -->
        <Style x:Key="KeyBoxStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FF1F2023" />
            <Setter Property="BorderBrush" Value="#FF3A3B42" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="9" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF2A2B30" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 묶음 제목 · 판 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#FF26272B" />
            <Setter Property="BorderBrush" Value="#FF303137" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF3A3B42" BorderThickness="1">
        <StackPanel>
            <Grid Height="44" Background="{StaticResource TitleBrush}">
                <StackPanel Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="#FFD9DCE3" />
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="설정" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Margin="0,0,5,0" Style="{StaticResource CloseChromeButtonStyle}" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기 (Esc)">
                    <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                </Button>
            </Grid>

            <StackPanel Margin="22,18,22,20">
                <!-- 단축키 -->
                <DockPanel Margin="0,0,0,0">
                    <Button DockPanel.Dock="Right" Margin="0,0,2,6" Style="{StaticResource LinkButtonStyle}" FontSize="12" Click="Reset_Click" Content="기본값으로" />
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="단축키" />
                </DockPanel>
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <StackPanel x:Name="Rows" />
                        <TextBlock x:Name="Message" Margin="0,2,0,6" FontSize="12.5" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="칸을 누르고 원하는 키나 조합을 누르세요. Esc 는 그대로 두기, × 는 단축키 없애기." />
                    </StackPanel>
                </Border>

                <!-- 저장 위치 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="저장 위치" />
                <Border Style="{StaticResource SectionStyle}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource PillButtonStyle}" Height="30" Click="OpenFolder_Click" Content="열기" />
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PillButtonStyle}" Height="30" Click="ChangeFolder_Click" Content="바꾸기" />
                        <TextBlock x:Name="FolderText" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <!-- 일반 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="일반" />
                <Border Style="{StaticResource SectionStyle}" Margin="0">
                    <StackPanel>
                        <CheckBox x:Name="StartupBox" FontSize="13" Content="Windows 시작할 때 실행" Checked="StartupBox_Changed" Unchecked="StartupBox_Changed" />
                        <TextBlock Margin="24,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="트레이에서 기다리다 단축키를 누르면 바로 캡처합니다." />
                    </StackPanel>
                </Border>

                <Button Margin="0,20,0,0" HorizontalAlignment="Right" Style="{StaticResource PrimaryPillButtonStyle}" Click="Close_Click" Content="닫기" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
