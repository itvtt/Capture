<Window x:Class="Capture.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Capture"
        Icon="Assets/Capture.ico"
        Width="1000" Height="700" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 제목 표시줄: 파일 이름 · 크기, 창 버튼 -->
        <Border Background="{StaticResource TitleBrush}">
            <Grid Margin="16,0,6,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Source="Assets/Capture.png" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FileText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DirtyText" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Text="•" Visibility="Collapsed" ToolTip="저장하지 않은 고친 내용이 있습니다" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseChromeButtonStyle}" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기 (Esc)">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 도구 막대: 도구 · 색 · 굵기 · 되돌리기 | 복사 · 공유 · 더 보기 -->
        <Border Grid.Row="1" Background="{StaticResource TitleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0,12,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RectTool" Style="{StaticResource ToolStyle}" GroupName="Tool" IsChecked="True" Checked="Tool_Checked" ToolTip="사각형 (R)">
                        <Path Width="18" Height="18" Data="M 2.5,4.5 L 15.5,4.5 15.5,13.5 2.5,13.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                    </RadioButton>
                    <RadioButton x:Name="ArrowTool" Style="{StaticResource ToolStyle}" GroupName="Tool" Checked="Tool_Checked" ToolTip="화살표 (A)">
                        <Path Width="18" Height="18" Data="M 3,15 L 14.5,3.5 M 7,3.5 L 14.5,3.5 14.5,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </RadioButton>
                    <RadioButton x:Name="PenTool" Style="{StaticResource ToolStyle}" GroupName="Tool" Checked="Tool_Checked" ToolTip="펜 (P)">
                        <Path Width="18" Height="18" Data="M 3,15 L 3.8,11.4 12.2,3 15,5.8 6.6,14.2 Z M 10.4,4.8 L 13.2,7.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                    </RadioButton>
                    <RadioButton x:Name="MarkerTool" Style="{StaticResource ToolStyle}" GroupName="Tool" Checked="Tool_Checked" ToolTip="형광펜 (H)">
                        <Grid Width="18" Height="18">
                            <Rectangle Width="16" Height="5" Margin="0,0,0,1" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5" Fill="#B3FFD60A" />
                            <Path Data="M 5,11 L 11.5,3 15,5.8 8.5,13.8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="TextTool" Style="{StaticResource ToolStyle}" GroupName="Tool" Checked="Tool_Checked" ToolTip="글자 (T)">
                        <Path Width="18" Height="18" Data="M 3.5,5 L 3.5,3 14.5,3 14.5,5 M 9,3 L 9,15 M 6.5,15 L 11.5,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </RadioButton>
                    <RadioButton x:Name="MosaicTool" Style="{StaticResource ToolStyle}" GroupName="Tool" Checked="Tool_Checked" ToolTip="모자이크 (M)">
                        <Path Width="18" Height="18" Data="M 2,2 L 7,2 7,7 2,7 Z M 12,2 L 16,2 16,7 12,7 Z M 7,7 L 12,7 12,12 7,12 Z M 2,12 L 7,12 7,16 2,16 Z M 12,12 L 16,12 16,16 12,16 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton x:Name="CropTool" Style="{StaticResource ToolStyle}" GroupName="Tool" Checked="Tool_Checked" ToolTip="자르기 (C)">
                        <Path Width="18" Height="18" Data="M 5,1.5 L 5,13 16.5,13 M 1.5,5 L 13,5 13,16.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </RadioButton>

                    <Border Width="1" Height="22" Margin="8,0" Background="#FF3A3B42" />
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" />
                    <Border Width="1" Height="22" Margin="8,0" Background="#FF3A3B42" />

                    <RadioButton x:Name="ThinSize" Style="{StaticResource ToolStyle}" GroupName="Size" Checked="Size_Checked" ToolTip="가늘게">
                        <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton x:Name="MediumSize" Style="{StaticResource ToolStyle}" GroupName="Size" IsChecked="True" Checked="Size_Checked" ToolTip="보통">
                        <Rectangle Width="16" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton x:Name="ThickSize" Style="{StaticResource ToolStyle}" GroupName="Size" Checked="Size_Checked" ToolTip="굵게">
                        <Rectangle Width="16" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>

                    <Border Width="1" Height="22" Margin="8,0" Background="#FF3A3B42" />
                    <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}" Click="Undo_Click" ToolTip="되돌리기 (Ctrl+Z)" IsEnabled="False">
                        <Path Width="16" Height="16" Data="M 5.5,2.5 L 2,6 5.5,9.5 M 2,6 L 10,6 C 12.5,6 14.5,8 14.5,10.25 14.5,12.5 12.5,14.5 10,14.5 L 7,14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}" Click="Redo_Click" ToolTip="다시 하기 (Ctrl+Y)" IsEnabled="False">
                        <Path Width="16" Height="16" Data="M 10.5,2.5 L 14,6 10.5,9.5 M 14,6 L 6,6 C 3.5,6 1.5,8 1.5,10.25 1.5,12.5 3.5,14.5 6,14.5 L 9,14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PillButtonStyle}" Click="Save_Click" ToolTip="저장 (Ctrl+S)" Content="저장" />
                    <Button Margin="6,0,0,0" Style="{StaticResource PillButtonStyle}" Click="Copy_Click" ToolTip="그림 복사 (Ctrl+C)" Content="복사" />
                    <Button x:Name="ShareButton" Margin="6,0,0,0" Style="{StaticResource PrimaryPillButtonStyle}" Click="Share_Click" ToolTip="File Shared 로 올리고 링크 복사">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Data="M 7,9.5 L 7,1.5 M 3.75,4.75 L 7,1.5 10.25,4.75 M 2,8 L 2,12.5 12,12.5 12,8" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock x:Name="ShareText" Margin="7,0,0,0" Text="공유" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" Click="More_Click" ToolTip="더 보기">
                        <Path Width="16" Height="4" Data="M 2,2 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0 M 8,2 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0 M 14,2 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0" Fill="#FFE5E5EA" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="다른 이름으로 저장…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"><MenuItem.Icon><TextBlock Text="&#xE792;" /></MenuItem.Icon></MenuItem>
                                <MenuItem x:Name="ShowInFolderItem" Header="폴더에서 보기" Click="ShowInFolder_Click"><MenuItem.Icon><TextBlock Text="&#xE838;" /></MenuItem.Icon></MenuItem>
                                <Separator />
                                <MenuItem x:Name="DeleteItem" Header="휴지통으로" Style="{StaticResource DangerMenuItemStyle}" Click="Delete_Click"><MenuItem.Icon><TextBlock Text="&#xE74D;" /></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 그림: 화소 1개 = 1 단위인 판(Sheet)을 확대 · 축소해 보여 줌 -->
        <ScrollViewer x:Name="Viewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF121214"
                      PreviewMouseWheel="Viewer_PreviewMouseWheel" SizeChanged="Viewer_SizeChanged" Focusable="False">
            <Grid x:Name="Zoomer" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Margin="-1" BorderBrush="#FF2E2F35" BorderThickness="1" IsHitTestVisible="False" />
                <Grid x:Name="Sheet" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="Base" Stretch="Fill" />
                    <Canvas x:Name="Ink" Background="Transparent" Cursor="Cross"
                            MouseLeftButtonDown="Ink_MouseLeftButtonDown" MouseMove="Ink_MouseMove" MouseLeftButtonUp="Ink_MouseLeftButtonUp" />
                    <Rectangle x:Name="Marquee" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="White" StrokeDashArray="4 3" Fill="#223B82F6" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 상태 줄 -->
        <Border Grid.Row="3" Background="{StaticResource TitleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Cursor="Hand"
                           MouseLeftButtonUp="ZoomText_MouseLeftButtonUp" ToolTip="누르면 실제 크기 ↔ 창에 맞춤 (Ctrl+휠로 확대 · 축소)" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
