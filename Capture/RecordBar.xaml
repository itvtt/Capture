<Window x:Class="Capture.RecordBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="#FF26272B" Foreground="#FFF5F5F7"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <!-- 녹화 · 스크롤 캡처 중 막대: 상태 · 시간 · 멈춤 · 취소. 화면 캡처에는 찍히지 않음 -->
    <Border x:Name="Frame" BorderBrush="#FF3A3B42" BorderThickness="1">
        <StackPanel Margin="12,7,7,7" Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFFF453A" VerticalAlignment="Center" />
            <TextBlock x:Name="StateText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="GIF" />
            <TextBlock x:Name="TimeText" Margin="8,0,14,0" MinWidth="42" VerticalAlignment="Center" FontSize="13" Foreground="#FFC7C7CC" Text="00:00" />
            <Button x:Name="StopButton" Style="{StaticResource PrimaryPillButtonStyle}" Height="30" Click="Stop_Click" ToolTip="멈추고 저장 (단축키를 한 번 더)">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                    <TextBlock x:Name="StopText" Margin="7,0,0,0" Text="멈춤" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" Click="Cancel_Click" ToolTip="취소 (저장하지 않음)">
                <Path Width="11" Height="11" Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="#FFD1D1D6" StrokeThickness="1.4" />
            </Button>
        </StackPanel>
    </Border>
</Window>
