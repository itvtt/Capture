<Window x:Class="Capture.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black" Cursor="Cross"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- 모드 막대의 버튼: 아이콘 + 이름, 고른 것은 파랗게 -->
        <Style x:Key="ModeStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0,13,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="#FFE5E5EA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF37383E" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FF3B82F6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0,13,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="#FFE5E5EA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF37383E" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Black"
          MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp" MouseRightButtonUp="Root_MouseRightButtonUp">
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" />
        <!-- 고른 곳 밖은 어둡게 -->
        <Path x:Name="Shade" Fill="#8C000000" IsHitTestVisible="False" />
        <Rectangle x:Name="Outline" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="#FF3B82F6" StrokeThickness="2" IsHitTestVisible="False" Visibility="Collapsed" />
        <Border x:Name="SizeTag" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,3" CornerRadius="6" Background="#E61C1C1E" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" FontSize="12" Foreground="White" />
        </Border>

        <!-- 돋보기: 마우스 둘레 19 × 19 화소를 6배로 -->
        <Border x:Name="Loupe" Width="124" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4" CornerRadius="10"
                Background="#F21C1C1E" BorderBrush="#FF45464D" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel>
                <Grid Width="114" Height="114" ClipToBounds="True">
                    <Rectangle x:Name="LoupeImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Rectangle Width="6" HorizontalAlignment="Center" Fill="#403B82F6" />
                    <Rectangle Height="6" VerticalAlignment="Center" Fill="#403B82F6" />
                    <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1" />
                </Grid>
                <TextBlock x:Name="LoupeText" Margin="2,4,2,1" HorizontalAlignment="Center" FontSize="11" Foreground="#FFD0D0D6" />
            </StackPanel>
        </Border>

        <!-- 모드 막대 (마우스가 있던 모니터에만) -->
        <StackPanel x:Name="Bar" Margin="0,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Arrow" Visibility="Collapsed">
            <Border Padding="5" CornerRadius="14" Background="#F526272B" BorderBrush="#FF3A3B42" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RegionMode" Style="{StaticResource ModeStyle}" GroupName="Mode" Checked="Mode_Checked" ToolTip="영역 · 창 · 전체 화면 캡처">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Data="{StaticResource RegionIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Margin="7,0,0,0" Text="영역" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScrollMode" Style="{StaticResource ModeStyle}" GroupName="Mode" Checked="Mode_Checked" ToolTip="스크롤하며 긴 화면 한 장으로">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Data="{StaticResource ScrollIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Margin="7,0,0,0" Text="스크롤" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="GifMode" Style="{StaticResource ModeStyle}" GroupName="Mode" Checked="Mode_Checked" ToolTip="움직이는 그림(GIF) 녹화">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Data="{StaticResource GifIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <TextBlock Margin="7,0,0,0" Text="GIF" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VideoMode" Style="{StaticResource ModeStyle}" GroupName="Mode" Checked="Mode_Checked" ToolTip="영상(MP4) 녹화">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Data="{StaticResource VideoIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" />
                            <TextBlock Margin="7,0,0,0" Text="영상" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Border Width="1" Margin="6,7" Background="#FF45464D" />
                    <Button Style="{StaticResource BarButtonStyle}" Click="FullScreen_Click" ToolTip="이 모니터 전체 (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Data="{StaticResource ScreenIcon}" Stroke="#FFE5E5EA" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Margin="7,0,0,0" Text="전체 화면" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Width="34" Padding="0" Style="{StaticResource BarButtonStyle}" Click="Cancel_Click" ToolTip="취소 (Esc)">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="#FFE5E5EA" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Border>
            <Border Margin="0,8,0,0" HorizontalAlignment="Center" Padding="11,4" CornerRadius="10" Background="#B3000000">
                <TextBlock x:Name="Hint" FontSize="12.5" Foreground="#FFEDEDF0" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
