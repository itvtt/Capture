<Window x:Class="Capture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Capture"
        Title="Capture"
        Icon="Assets/Capture.ico"
        Width="680" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        StateChanged="Window_StateChanged" Activated="Window_Activated" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 캡처 방식 칸: 아이콘 · 이름 · 단축키 -->
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="16" Background="#FF26272B" BorderBrush="#FF303137" BorderThickness="1">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FF2E2F35" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF45464D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF7FB0FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 최근 칸: 미리 보기 + 이름 -->
        <Style x:Key="RecentStyle" TargetType="Button">
            <Setter Property="Width" Value="140" />
            <Setter Property="Margin" Value="0,0,12,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="10" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RecentTemplate" DataType="{x:Type local:RecentItem}">
            <Button Style="{StaticResource RecentStyle}" Tag="{Binding}" Click="Recent_Click" ToolTip="{Binding Name}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="열기" Tag="{Binding}" Click="RecentOpen_Click"><MenuItem.Icon><TextBlock Text="&#xE8E5;" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="복사" Tag="{Binding}" Click="RecentCopy_Click"><MenuItem.Icon><TextBlock Text="&#xE8C8;" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="공유 (File Shared)" Tag="{Binding}" Click="RecentShare_Click"><MenuItem.Icon><TextBlock Text="&#xE72D;" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="폴더에서 보기" Tag="{Binding}" Click="RecentFolder_Click"><MenuItem.Icon><TextBlock Text="&#xE838;" /></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="휴지통으로" Tag="{Binding}" Style="{StaticResource DangerMenuItemStyle}" Click="RecentDelete_Click"><MenuItem.Icon><TextBlock Text="&#xE74D;" /></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Border Height="92" CornerRadius="10" Background="#FF26272B" BorderBrush="#FF303137" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Path Width="22" Height="22" Data="{StaticResource VideoIcon}" Stretch="Uniform" Stroke="#FFC7C7CC" StrokeThickness="1.4" Visibility="{Binding VideoIconVisibility}" />
                            <Border Margin="6" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5" Background="#CC000000" Visibility="{Binding BadgeVisibility}">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="White" Text="{Binding Badge}" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Margin="2,6,2,0" FontSize="11.5" Foreground="#FFB4B4BA" Text="{Binding When}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- 제목 표시줄 -->
        <Border Background="{StaticResource TitleBrush}">
            <Grid Margin="16,0,6,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="22" Height="22" Source="Assets/Capture.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Capture" />
                    <TextBlock x:Name="VersionText" Margin="8,1,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseChromeButtonStyle}" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기 (트레이에서 계속 실행)">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="19,18,19,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 캡처 방식 -->
            <UniformGrid Columns="4">
                <Button x:Name="RegionTile" Style="{StaticResource TileStyle}" Click="Tile_Click" Tag="Region" ToolTip="끌면 영역 · 누르면 창 · Enter 전체 화면">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#263B82F6" HorizontalAlignment="Center">
                            <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource RegionIcon}" Stroke="#FF7FB0FF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="영역" />
                        <TextBlock x:Name="RegionKey" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScrollTile" Style="{StaticResource TileStyle}" Click="Tile_Click" Tag="Scroll" ToolTip="스크롤하며 긴 화면 한 장으로">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#2630D158" HorizontalAlignment="Center">
                            <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource ScrollIcon}" Stroke="#FF5FE08A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="스크롤" />
                        <TextBlock x:Name="ScrollKey" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="GifTile" Style="{StaticResource TileStyle}" Click="Tile_Click" Tag="Gif" ToolTip="움직이는 그림 (GIF) 녹화">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#26FF9F0A" HorizontalAlignment="Center">
                            <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource GifIcon}" Stroke="#FFFFB84D" StrokeThickness="1.6" StrokeLineJoin="Round" />
                        </Border>
                        <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="GIF" />
                        <TextBlock x:Name="GifKey" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="VideoTile" Style="{StaticResource TileStyle}" Click="Tile_Click" Tag="Video" ToolTip="영상 (MP4) 녹화">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#26FF453A" HorizontalAlignment="Center">
                            <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource VideoIcon}" Stroke="#FFFF7A70" StrokeThickness="1.6" />
                        </Border>
                        <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="영상" />
                        <TextBlock x:Name="VideoKey" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <DockPanel Grid.Row="1" Margin="5,24,5,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Click="OpenFolder_Click" Content="폴더 열기" />
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="최근" />
            </DockPanel>

            <ScrollViewer x:Name="RecentScroll" Grid.Row="2" Margin="5,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecentTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                       Text="캡처하면 여기에 쌓입니다" Visibility="Collapsed" />
        </Grid>

        <!-- PrtSc 를 Windows 캡처 도구가 쓰고 있을 때 -->
        <Border x:Name="HotkeyWarning" Grid.Row="2" Margin="24,0,24,12" Padding="14,10" CornerRadius="10" Background="#1FFFC56B" BorderBrush="#40FFC56B" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource PillButtonStyle}" Height="28" Click="Hotkeys_Click" Content="단축키 바꾸기" />
                <Button x:Name="WindowsSettingsButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PillButtonStyle}" Height="28" Click="KeyboardSettings_Click" Content="Windows 설정" />
                <TextBlock x:Name="HotkeyWarningText" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- 아래: 저장 위치 · 시작할 때 실행 -->
        <Border Grid.Row="3" Background="{StaticResource TitleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" FontSize="12" Content="Windows 시작할 때 실행" Checked="StartupBox_Changed" Unchecked="StartupBox_Changed" />
                <Button DockPanel.Dock="Right" Margin="0,0,18,0" Style="{StaticResource LinkButtonStyle}" FontSize="12" Click="Hotkeys_Click" Content="단축키 바꾸기" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="저장 위치" />
                    <TextBlock x:Name="FolderText" Margin="8,0,0,0" MaxWidth="300" FontSize="12" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonUp="FolderText_Click" ToolTip="폴더 열기" />
                    <Button Margin="10,0,0,0" Style="{StaticResource LinkButtonStyle}" FontSize="12" Click="ChangeFolder_Click" Content="바꾸기" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
